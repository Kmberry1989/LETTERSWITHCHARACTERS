# Public Firebase web app configuration. The checked-in defaults target the
# Letters with Characters project; these overrides are useful for staging.
NEXT_PUBLIC_FIREBASE_PROJECT_ID="studio-1704097120-f2816"

# Use the Auth and Firestore emulators for a credential-free local run.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS="true"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Non-Google production hosts need one base64-encoded service-account JSON value.
# Firebase App Hosting / Google Cloud should use Application Default Credentials instead.
# FIREBASE_SERVICE_ACCOUNT_JSON="BASE64_ENCODED_JSON"

# Optional production origin used for same-origin mutation checks.
APP_ORIGIN="http://localhost:9002"

# Optional Genkit / Google AI configuration can be added here when AI hints are enabled.
